{
  "name": "dsh-raw-agent-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for dsh-raw-agent. Only packages/plugin is published.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli-constants": "tsc -b && node scripts/test-cli-constants.mjs",
    "lint": "eslint . && prettier --check . && node scripts/check-imports.mjs",
    "check-imports": "node scripts/check-imports.mjs",
    "format": "prettier --write .",
    "clean": "node scripts/clean.mjs",
    "check-pack": "node scripts/check-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
