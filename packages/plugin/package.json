{
  "name": "dsh-raw-agent",
  "version": "0.0.0",
  "description": "Run your own, unmodified Claude Code inside DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./agent": "./lib/agent.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/host.js",
    "lib/host.js.map",
    "lib/agent.js",
    "lib/agent.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "tsc -b && node ../../scripts/bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318"
  },
  "devDependencies": {
    "@dsh-raw-agent/backend-claude": "workspace:*",
    "@dsh-raw-agent/core": "workspace:*",
    "@dsh-raw-agent/dsh-host": "workspace:*",
    "@dsh-raw-agent/dsh-client": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
